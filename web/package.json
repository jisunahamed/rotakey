{
  "name": "rotakey-admin",
  "private": true,
  "version": "3.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run check:css",
    "check:css": "npm run lint:css && npm run check:css-vars && npm run check:css-classes",
    "lint:css": "node scripts/lint-css.cjs",
    "check:css-vars": "node scripts/check-css-vars.cjs",
    "check:css-classes": "node scripts/check-css-classes.cjs",
    "check:css-order": "node scripts/check-css-order.cjs",
    "check:moved": "node scripts/check-moved.cjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "stylelint": "^17.14.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
