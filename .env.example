# Copy to .env, replace every CHANGE_ME value, then run: docker compose up -d --build
APP_HOST=:80
CADDYFILE=./deploy/Caddyfile.ip
PUBLIC_BASE_URL=http://YOUR_VPS_IP
SESSION_COOKIE_SECURE=false

POSTGRES_USER=rotakey
POSTGRES_DB=rotakey
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# Generate: openssl rand -base64 32
APP_MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# Generate: openssl rand -hex 32
BOOTSTRAP_TOKEN=CHANGE_ME_RANDOM_BOOTSTRAP_TOKEN

MAX_REQUEST_BYTES=8388608
MAX_MESSAGE_BYTES=33554432
MAX_BATCH_BYTES=268435456
MAX_FILE_BYTES=500000000
MAX_RESPONSE_BYTES=16777216
CAPTURE_BYTES=1048576
SESSION_TTL_HOURS=12
