{$APP_HOST} {
	encode zstd gzip
	reverse_proxy app:8080

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format json
	}
}

# Domain mode catch-all. Preserve POST/stream methods while moving requests
# addressed to the VPS IP onto the canonical HTTPS hostname.
http:// {
	redir https://{$APP_HOST}{uri} 308
}
