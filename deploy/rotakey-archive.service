[Unit]
Description=Archive verified Rotakey requests to Supabase
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/opt/rotakey
ExecStart=/usr/bin/docker run --rm --name rotakey-request-archive --network rotakey_default --env-file /opt/rotakey/.archive.env --read-only --tmpfs /tmp:size=16m --cap-drop ALL --security-opt no-new-privileges:true --entrypoint /usr/local/bin/rotakey-archive rotakey-app:latest
TimeoutStartSec=infinity
TimeoutStopSec=45
Restart=on-failure
RestartSec=5min
StandardOutput=journal
StandardError=journal
